# Copy to .env for `pnpm dev:gateway`. Installed services read ~/.config/charlotte/gateway.env.
DATABASE_URL=postgres://charlotte:CHANGE_ME@127.0.0.1:5432/charlotte
HOST=127.0.0.1
PORT=4000
AUDIO_SERVER_URL=http://127.0.0.1:8080
# Set to true only when the GUI is served over HTTPS.
COOKIE_SECURE=false
